{
  "description": "Monitor de Claude: anota el estado de cada chat (trabajando, esperando, terminada) para la ventanita de Clawd. Solo escribe; no aprueba ni bloquea nada.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon.py\"", "timeout": 5 } ] }
    ]
  }
}
